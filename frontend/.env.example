# Copy to frontend/.env.local (git-ignored) and adjust. Read by Vite in `npm run dev` and `npm run build`.
# These values are embedded in the public page: never put API keys, tokens, or credentials here.

# FastAPI base URL (no trailing slash needed). The backend must allow this page's origin via FINDORA_CORS_ORIGINS.
VITE_API_URL=http://localhost:8000

# Initial data source when the browser has no saved choice: `demo` (synthetic clothing fixtures) or `api`.
# A ?mode=api or ?mode=demo URL parameter overrides this for a visit.
VITE_DEFAULT_MODE=demo
